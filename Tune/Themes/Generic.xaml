<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tab="clr-namespace:Tune.Components.TabFrame">
    
    <!--
        Generated by AI, according to hand-written style
    -->
    <!-- ============================================================
         TabFrameItem default style: only a ContentPresenter, no background, no border
         ============================================================ -->
    <Style TargetType="{x:Type tab:TabFrameItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type tab:TabFrameItem}">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         ListBoxItem default style for TabFrame: background, border, and triggers for selected and disabled states
         ============================================================ -->
    <Style x:Key="TabFrameTabItemStyle" TargetType="ListBoxItem">
        <Setter Property="Cursor"    Value="Hand"/>
        <Setter Property="Foreground" Value="#6B7280"/>
        <Setter Property="FontSize"  Value="14"/>
        <Setter Property="Margin"    Value="8,0,0,0"/>
        <Setter Property="Width"     Value="160"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid SnapsToDevicePixels="True">
                        <Image x:Name="StandbyBg"
                               Stretch="Uniform"
                               Source="pack://application:,,,/Tune;component/Assets/Components/Tab/TabStandby.png"/>

                        <Image x:Name="ClickedBg"
                               Stretch="Uniform"
                               Visibility="Collapsed"
                               Source="pack://application:,,,/Tune;component/Assets/Components/Tab/TabClicked.png"/>
                        
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="StandbyBg" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ClickedBg" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         TabFrame default style: includes the default TabFrameTabItemStyle for its ListBox items
         ============================================================ -->
    <Style TargetType="{x:Type tab:TabFrame}">
        <Setter Property="TabContainerStyle" Value="{StaticResource TabFrameTabItemStyle}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type tab:TabFrame}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <ListBox x:Name="PART_ItemsHost"
                                     Background="Transparent"
                                     Margin="8,5,0,-1"
                                     BorderThickness="0"
                                     Focusable="False"
                                     HorizontalContentAlignment="Stretch"
                                     VerticalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                            <Border Height="2.5"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Bottom"
                                    Background="White"
                                    IsHitTestVisible="False"
                                    Panel.ZIndex="1"/>
                        </Grid>

                        <ContentPresenter x:Name="PART_ContentHost"
                                          Grid.Row="1"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>