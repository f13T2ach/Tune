<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tab="clr-namespace:Tune.Components.TabFrame">
    <!--Generated by AI, according to hand-written style-->

    <Style x:Key="TabFrameItemContainerStyle" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="#6B7280"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="Width" Value="160"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid SnapsToDevicePixels="True">
                        <Image x:Name="StandbyBg"
                               Stretch="Uniform"
                               Source="pack://application:,,,/Tune.Components.TabFrame;component/Assets/Components/Tab/TabStandby.png"/>
                        <Image x:Name="ClickedBg"
                               Stretch="Uniform"
                               Visibility="Collapsed"
                               Source="pack://application:,,,/Tune.Components.TabFrame;component/Assets/Components/Tab/TabClicked.png"/>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="StandbyBg" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ClickedBg" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <DataTemplate x:Key="TabFrameItemTemplate">
        <TextBlock Text="{Binding Header}" FontSize="30" Margin="0,5,0,0"/>
    </DataTemplate>

</ResourceDictionary>