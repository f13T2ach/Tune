<UserControl x:Class="Tune.Appearance.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Tune.Appearance"
      xmlns:lang="clr-namespace:Tune.Assets.Localization"
      xmlns:bar="clr-namespace:Tune.Components.Bar"
      xmlns:converters="clr-namespace:Tune.Helpers.ValueConverters"
      xmlns:components="clr-namespace:Tune.Components"
      xmlns:input="clr-namespace:Tune.Components.InputBox"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1600">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="200*" />
            <RowDefinition Height="30*" />
        </Grid.RowDefinitions>

        <!-- Page content, laid out like the playlists page -->
        <Grid Grid.Row="0" Margin="48,32,40,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title -->
            <Grid Grid.Row="0">
                <TextBlock Text="{x:Static lang:LangStrings.Settings}" FontWeight="SemiBold" FontSize="50"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock Text="Tune Database" TextAlignment="Right" FontSize="16"/>
                        <TextBlock Text="Version 1.0.0, Settings" TextAlignment="Right" FontSize="16"/>
                        <TextBlock Text="Soka Software" TextAlignment="Right" FontSize="16"/>
                    </StackPanel>
                    <Image Source="/Assets/Icons/TuneDataBaseIcon.png" Width="50" Margin="8"/>

                    <components:ExitButton Height="50" ExitCommand="{Binding NavigateToMainCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Categories on the left, the settings of the selected one on the right -->
            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListBox Grid.Column="0"
                         ItemsSource="{Binding Categories}"
                         SelectedIndex="{Binding SelectedCategoryIndex, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Left"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Opacity" Value="0.55" />
                            <Setter Property="Padding" Value="0,0,0,14" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.8" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <Grid Grid.Column="1" Margin="24,0,0,0">
                    <Border Background="White" Opacity="0.13" />
                    <Grid Margin="28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- General -->
                        <StackPanel Grid.Row="0"
                                    Visibility="{Binding IsGeneralSelected, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{x:Static lang:LangStrings.Language}" FontSize="30" FontWeight="SemiBold"/>
                            <ComboBox Width="320" HorizontalAlignment="Left" Margin="0,14,0,0"
                                      ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                            <TextBlock Text="{x:Static lang:LangStrings.LanguageRestartHint}" FontSize="20"
                                       Opacity="0.7" Margin="0,12,0,0"/>
                        </StackPanel>

                        <!-- Audio -->
                        <StackPanel Grid.Row="0"
                                    Visibility="{Binding IsAudioSelected, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{x:Static lang:LangStrings.AudioApi}" FontSize="30" FontWeight="SemiBold"/>
                            <ComboBox Width="320" HorizontalAlignment="Left" Margin="0,14,0,0"
                                      ItemsSource="{Binding AudioApis}"
                                      SelectedItem="{Binding SelectedAudioApi, Mode=TwoWay}" />
                            <TextBlock Text="{x:Static lang:LangStrings.AudioApiRestartHint}" FontSize="20"
                                       Opacity="0.7" Margin="0,12,0,0"/>
                            <TextBlock Text="{x:Static lang:LangStrings.AudioApi}" Margin="0,14,0,0" FontSize="30" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Effects -->
                        <StackPanel Grid.Row="0"
                                    Visibility="{Binding IsEffectSelected, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{x:Static lang:LangStrings.CategoryEffect}" FontSize="30" FontWeight="SemiBold"/>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Text="{x:Static lang:LangStrings.EqBandMinimum}" FontSize="24"
                                           Opacity="0.7" Width="280" VerticalAlignment="Center"/>
                                <input:SimpleInputBox Width="140" FontSize="26"
                                                      Text="{Binding BandMinimumText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{x:Static lang:LangStrings.EqBandMaximum}" FontSize="24"
                                           Opacity="0.7" Width="280" VerticalAlignment="Center"/>
                                <input:SimpleInputBox Width="140" FontSize="26"
                                                      Text="{Binding BandMaximumText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{x:Static lang:LangStrings.EqBandStep}" FontSize="24"
                                           Opacity="0.7" Width="280" VerticalAlignment="Center"/>
                                <input:SimpleInputBox Width="140" FontSize="26"
                                                      Text="{Binding BandStepText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Lyrics -->

                        <StackPanel Grid.Row="0"

                                    Visibility="{Binding IsLyricSelected, Converter={StaticResource BoolToVisConverter}}">

                            <TextBlock Text="{x:Static lang:LangStrings.CategoryLyric}" FontSize="30" FontWeight="SemiBold"/>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">

                                <TextBlock Text="{x:Static lang:LangStrings.LyricLineLimit}" FontSize="24"

                                           Opacity="0.7" Width="280" VerticalAlignment="Center"/>

                                <ComboBox Width="140" SelectedIndex="{Binding SelectedLineLimitIndex, Mode=TwoWay}">

                                    <ComboBoxItem>1</ComboBoxItem>

                                    <ComboBoxItem>2</ComboBoxItem>

                                    <ComboBoxItem>3</ComboBoxItem>

                                </ComboBox>
                            </StackPanel>

                            <!-- Secondary lyric, with the note under it -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{x:Static lang:LangStrings.SecondaryLyric}" FontSize="24"
                                           Opacity="0.7" Width="280" VerticalAlignment="Center"/>
                                <ComboBox Width="240"
                                          SelectedIndex="{Binding SelectedSecondaryLyricIndex, Mode=TwoWay}">
                                    <ComboBoxItem Tag="translation" Content="{x:Static lang:LangStrings.LyricSecondaryTranslation}"/>
                                    <ComboBoxItem Tag="third" Content="{x:Static lang:LangStrings.LyricSecondaryThirdLine}"/>
                                </ComboBox>
                            </StackPanel>

                            <TextBlock Text="{x:Static lang:LangStrings.LyricThirdLineHint}" FontSize="20"
                                       Opacity="0.6" TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="560"
                                       HorizontalAlignment="Left"/>

                            </StackPanel>



                        <!-- About -->
                        <StackPanel Grid.Row="0"
                                    Visibility="{Binding IsAboutSelected, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding AppName}" FontSize="30" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Text="{x:Static lang:LangStrings.Version}" FontSize="24"
                                           Opacity="0.7" Width="200"/>
                                <TextBlock Text="{Binding VersionText}" FontSize="24"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{x:Static lang:LangStrings.Runtime}" FontSize="24"
                                           Opacity="0.7" Width="200"/>
                                <TextBlock Text="{Binding RuntimeText}" FontSize="24"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{x:Static lang:LangStrings.Developer}" FontSize="24"
                                           Opacity="0.7" Width="200"/>
                                <TextBlock Text="{x:Static lang:LangStrings.DeveloperName}" FontSize="24"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Save, bottom right of the settings area -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding SaveHint}" FontSize="22" Opacity="0.8"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <components:Button Text="{x:Static lang:LangStrings.Save}" Width="135" FontSize="30"
                                               IsDisabled="{Binding IsSaveDisabled}"
                                               Command="{Binding SaveCommand}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <bar:PlayerControlBar Grid.Row="1"/>
    </Grid>
</UserControl>
