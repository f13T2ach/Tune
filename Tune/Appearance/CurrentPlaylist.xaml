<UserControl x:Class="Tune.Appearance.CurrentPlaylist"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Tune.Appearance"
      xmlns:lang="clr-namespace:Tune.Assets.Localization"
      xmlns:vm="clr-namespace:Tune.ViewModel"
      xmlns:frame="clr-namespace:Tune.Components.Frame"
      xmlns:svc="clr-namespace:Tune.Services"
      xmlns:converters="clr-namespace:Tune.Helpers.ValueConverters"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1600"
      xmlns:components="clr-namespace:Tune.Components">


    <UserControl.Resources>
        <converters:SecondsToDurationConverter x:Key="SecondsToDurationFormat" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>
    <Grid >
        <!--Main Box-->
        <Grid >
            <!--Docker-->
            <Grid>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="200*"/>
                        <RowDefinition Height="30*"/>
                    </Grid.RowDefinitions>
                    <!--Left Up Content-->
                    <Grid Grid.RowSpan="1" Margin="48,32,40,0">
                        <!--Album-->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="3*"/>
                            </Grid.RowDefinitions>
                            <!--Title-->
                            <Grid Grid.Row="0">
                                <!--Content-->
                                <Grid Margin="10">

                                    <StackPanel Orientation="Vertical" Margin="10,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <TextBlock Text="此处显示歌单名" FontWeight="SemiBold"/>
                                        <Grid Height="5"/>
                                        <TextBlock Text="无注释"/>

                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="12,0,0,6" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                                        <Grid Grid.Row="1" Background="White" Margin="0,0,12,0">
                                            <TextBlock Foreground="Black" Text="单曲歌单" FontSize="23" Margin="4,2,4,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Grid.Row="1" Background="White" Margin="0,0,12,0">
                                            <TextBlock Foreground="Black" Text="2026/8/30" FontSize="23" Margin="4,2,4,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Grid.Row="1" Background="White" Margin="0,0,12,0">
                                            <TextBlock Foreground="Black" Text="10首歌曲" FontSize="23" Margin="4,2,4,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="20" HorizontalAlignment="Right" VerticalAlignment="Bottom">

                                        <components:Button Margin="10,0,0,0" Text=" + " VerticalAlignment="Center"/>
                                        <components:Button Margin="10,0,0,0" Text="播放" VerticalAlignment="Center"/>
                                        <Grid Width="2" Background="White" Opacity="0.7" Margin="12,0,2,0"/>
                                        <components:Button Margin="10,0,0,0" Text="重命名" VerticalAlignment="Center"/>
                                        <components:Button Margin="10,0,0,0" Text="更新" VerticalAlignment="Center"/>
                                        <components:Button Margin="10,0,0,0" Text="删除" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <frame:HeaderFrame/>
                                <components:ImageButton Source="/Assets/Components/HomeButton.png" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding NavigateToMainCommand}" Width="28" Margin="0,4,2,0"/>
                            </Grid>
                            <!--Blank-->
                            <Grid Grid.Row="1">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0">
                                    <TextBlock Text="EMPTY" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="30" Text="{x:Static lang:LangStrings.EmptyPlaylist_C}"/>
                                </StackPanel>
                            </Grid>

                        </Grid>

                    </Grid>

                    <!--Left Down Content-->
                    <Grid Grid.Row="1" Background="#404040">

                        <Grid Grid.Row="1" Margin="49,0,24,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Grid Width="70" Margin="0,0,0,0">
                                    <components:SwitchMusic Width="60"/>
                                </Grid>
                                <Grid Width="12"/>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding MusicDisplay.Title}" Margin="0,0,0,-6" FontSize="32" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding MusicDisplay.Artist}" Margin="0,0,0,0" FontSize="30" />
                                </StackPanel>
                            </StackPanel>

                            <components:Timeline HorizontalAlignment="Center" Width="500"
                                                 IsEnded="True"
        CurrentSeconds="{Binding PlayerController.CurrentSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        TotalSeconds="{Binding MusicDisplay.TotalSeconds, Mode=OneWay}" Height="21" Margin="-15,8,0,0">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="DragCompleted">
                                        <i:InvokeCommandAction Command="{Binding SeekCommand}" 
                                    CommandParameter="{Binding PlayerController.CurrentSeconds}" />
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="DragStarted">
                                        <i:InvokeCommandAction Command="{Binding TimelineStartDraggingCommand}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </components:Timeline>

                            <!--Channel-->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Grid Width="12"/>

                                <Grid Width="12"/>


                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding PlayerController.CurrentSeconds, Converter={StaticResource SecondsToDurationFormat}}" Margin="0,0,0,-6" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding MusicLyric.Lyric}" Margin="0,0,0,0" FontSize="30" HorizontalAlignment="Right" />
                                </StackPanel>
                                <Grid HorizontalAlignment="Right" Width="90" Margin="0,0,0,5">
                                    <components:Pause IsPlaying="{Binding PlayerController.IsPlaying, Mode=OneWay}" ToggleCommand="{Binding PlayerController.TogglePlayPauseCommand}"/>
                                </Grid>



                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
