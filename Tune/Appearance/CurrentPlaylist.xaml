<UserControl x:Class="Tune.Appearance.CurrentPlaylist"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Tune.Appearance"
      xmlns:lang="clr-namespace:Tune.Assets.Localization"
      xmlns:vm="clr-namespace:Tune.ViewModel"
      xmlns:frame="clr-namespace:Tune.Components.Frame"
             xmlns:bar="clr-namespace:Tune.Components.Bar"
      xmlns:svc="clr-namespace:Tune.Services"
      xmlns:converters="clr-namespace:Tune.Helpers.ValueConverters"
      xmlns:content="clr-namespace:Tune.Components.Content"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1600"
      xmlns:components="clr-namespace:Tune.Components">


    <UserControl.Resources>
        <converters:SecondsToDurationConverter x:Key="SecondsToDurationFormat" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>
    
    <Grid >
        <!--Main Box-->
        <Grid >
            <!--Docker-->
            <Grid>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="200*"/>
                        <RowDefinition Height="30*"/>
                    </Grid.RowDefinitions>
                    <!--Left Up Content-->
                    <Grid Grid.RowSpan="1" Margin="48,32,40,0">
                        <!--Album-->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="3*"/>
                            </Grid.RowDefinitions>
                            <!--Title-->
                            <Grid Grid.Row="0">
                                <!--Content-->
                                <Grid Margin="10">

                                    <StackPanel Orientation="Vertical" Margin="10,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding ListController.CurrentPlaylistName}" FontWeight="SemiBold"/>
                                        <Grid Height="5"/>
                                        <TextBlock Text="{Binding ListController.CurrentPlaylistDescription}"/>

                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="12,0,0,6" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                                        <Grid Grid.Row="1" Background="White" Margin="0,0,12,0">
                                            <TextBlock Foreground="Black" Text="{Binding ListController.CurrentPlaylistType}" FontSize="23" Margin="4,2,4,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Grid.Row="1" Background="White" Margin="0,0,12,0">
                                            <TextBlock Foreground="Black" Text="2026/8/30" FontSize="23" Margin="4,2,4,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Grid.Row="1" Background="White" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Foreground="Black" Text="{Binding ListController.CurrentPlaylistCount}" FontSize="23" Margin="4,2,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Foreground="Black" Text="首歌曲" FontSize="23" Margin="4,2,4,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="20" HorizontalAlignment="Right" VerticalAlignment="Bottom">

                                        <components:Button Margin="10,0,0,0" Text=" + " Command="{Binding AddMusicClickedCommand}" VerticalAlignment="Center"/>
                                        <components:Button Margin="10,0,0,0" Text="播放" VerticalAlignment="Center"/>
                                        <Grid Width="2" Background="White" Opacity="0.7" Margin="12,0,2,0"/>
                                        <components:Button Margin="10,0,0,0" Text="重命名" VerticalAlignment="Center"/>
                                        <components:Button Margin="10,0,0,0" Text="更新" VerticalAlignment="Center"/>
                                        <components:Button Margin="10,0,0,0" Text="删除" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <frame:HeaderFrame/>
                                <components:ImageButton Source="/Assets/Components/HomeButton.png" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding NavigateToMainCommand}" Width="28" Margin="0,4,2,0"/>
                            </Grid>
                            <!--Blank-->
                            <Grid Grid.Row="1">
                                <!-- Empty hint -->
                                <StackPanel x:Name="EmptylistDesc"
                Visibility="{Binding ListController.IsPlaylistEmpty, Converter={StaticResource BoolToVisConverter}}"
                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0">
                                    <TextBlock Text="EMPTY" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   FontSize="30" Text="{x:Static lang:LangStrings.EmptyPlaylist_C}"/>
                                </StackPanel>

                                <!-- Music list (visible when playlist is not empty) -->
                                <ListBox ItemsSource="{Binding MusicList}"
             HorizontalContentAlignment="Stretch"
             Background="Transparent"
             BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ListController.IsPlaylistEmpty}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>

                                    <!-- Remove default ListBoxItem selection visual -->
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter HorizontalAlignment="Stretch"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <content:MusicItem
                    Music="{Binding}"
                    ClickCommand="{Binding DataContext.ClickItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                    ClickCommandParameter="{Binding}"
                    PlayNextCommand="{Binding DataContext.PlayNextCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                    AddToPlaylistCommand="{Binding DataContext.AddToPlaylistCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                    MoreCommand="{Binding DataContext.MoreCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                    DeleteCommand="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                        </Grid>
                        
                    </Grid>
                    <bar:PlayerControlBar Grid.Row="1"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
