<UserControl x:Class="Tune.Appearance.CurrentPlaylist"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Tune.Appearance"
      xmlns:vm="clr-namespace:Tune.ViewModel"
      xmlns:svc="clr-namespace:Tune.Services"
      xmlns:converters="clr-namespace:Tune.Helpers.ValueConverters"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1600"
      xmlns:components="clr-namespace:Tune.Components">


    <UserControl.Resources>
        <converters:SecondsToDurationConverter x:Key="SecondsToDurationFormat" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>
    <Grid >

        <Image Opacity="0" Source="/Tune;component/Assets/Tune.png"/>


        <!--Main Box-->
        <Grid >

            <!--Docker-->
            <Grid>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="200*"/>
                        <RowDefinition Height="37*"/>
                    </Grid.RowDefinitions>
                    <!--Left Up Content-->
                    <Grid Grid.RowSpan="1" Margin="48,32,40,0">
                        <!--Album-->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!--Title-->
                            <Grid Grid.Row="0">

                            </Grid>
                            <!--Blank-->
                            <Grid Grid.Row="1"></Grid>
                            <!--Timeline-->
                            <Grid Grid.Row="2" Margin="0,0,17,0">

                            </Grid>

                        </Grid>

                    </Grid>

                    <!--Left Down Content-->
                    <Grid Grid.Row="1">

                        <Grid Grid.Row="1" Margin="49,19,24,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Grid Width="70" Margin="0,0,0,0">
                                    <components:SwitchMusic Width="60"/>
                                </Grid>
                                <Grid Width="12"/>
                                <TextBlock Text="{Binding MusicDisplay.Title}" Margin="0,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <components:Timeline HorizontalAlignment="Center" Width="500"
        CurrentSeconds="{Binding PlayerController.CurrentSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        TotalSeconds="{Binding MusicDisplay.TotalSeconds, Mode=OneWay}" Height="42" Margin="-15,8,0,0">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="DragCompleted">
                                        <i:InvokeCommandAction Command="{Binding SeekCommand}" 
                                    CommandParameter="{Binding PlayerController.CurrentSeconds}" />
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="DragStarted">
                                        <i:InvokeCommandAction Command="{Binding TimelineStartDraggingCommand}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </components:Timeline>

                            <!--Channel-->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Grid Width="12"/>

                                <Grid Width="12"/>


                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding PlayerController.CurrentSeconds, Converter={StaticResource SecondsToDurationFormat}}" Margin="0,0,0,-6" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding MusicLyric.Lyric}" Margin="0,0,0,0" FontSize="30" HorizontalAlignment="Right" />
                                </StackPanel>
                                <Grid HorizontalAlignment="Right" Width="90" Margin="0,0,0,5">
                                    <components:Pause IsPlaying="{Binding PlayerController.IsPlaying, Mode=OneWay}" ToggleCommand="{Binding PlayerController.TogglePlayPauseCommand}"/>
                                </Grid>



                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
