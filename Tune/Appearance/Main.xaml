<UserControl x:Class="Tune.Appearance.Main"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Tune.Appearance"
      xmlns:vm="clr-namespace:Tune.ViewModel"
      xmlns:svc="clr-namespace:Tune.Services"
      xmlns:converters="clr-namespace:Tune.Helpers.ValueConverters"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1600"
      xmlns:components="clr-namespace:Tune.Components">


    <UserControl.Resources>
        <converters:SecondsToDurationConverter x:Key="SecondsToDurationFormat" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>
    <Grid >

        <Image Opacity="0" Source="/Tune;component/Assets/Tune.png"/>
        

        <!--Main Box-->
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="237*"/>
                <!--Consider replacing pixel value-->
                <RowDefinition Height="22*"/>
            </Grid.RowDefinitions>

            <!--Docker-->
            <Grid Grid.RowSpan="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16*"/>
                    <ColumnDefinition Width="9*"/>
                </Grid.ColumnDefinitions>
                <!--LEFT-->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="163*"/>
                        <RowDefinition Height="74*"/>
                    </Grid.RowDefinitions>
                    <!--Left Up Content-->
                    <Grid Grid.RowSpan="1" Margin="48,32,40,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="567*"/>
                            <ColumnDefinition Width="337*"/>
                        </Grid.ColumnDefinitions>
                        <!--Album-->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="130*"/>
                                <RowDefinition Height="198*"/>
                                <RowDefinition Height="131*"/>
                            </Grid.RowDefinitions>
                            <!--Title-->
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                    <!--Current Lyric-->
                                    <TextBlock Text="{Binding MusicLyric.TranslatedLyric}" Visibility="{Binding MusicDisplay.IsTranslated, Converter={StaticResource BoolToVisConverter}}" FontSize="24"/>
                                    <TextBlock Text="{Binding MusicLyric.Lyric}" FontSize="40"  Margin="2,0,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="5,7,0,0">
                                        <TextBlock Text="LYRIC" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Grid Width="12"/>
                                        <TextBlock Text="--/--" FontSize="28" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <!--Pause Control-->
                                <Grid HorizontalAlignment="Right" Width="90" Margin="0,0,0,5">
                                    <components:Pause IsPlaying="{Binding PlayerControl.IsPlaying, Mode=OneWay}" ToggleCommand="{Binding PlayerControl.TogglePlayPauseCommand}"/>
                                </Grid>
                            </Grid>
                            <!--Blank-->
                            <Grid Grid.Row="1"></Grid>
                            <!--Timeline-->
                            <Grid Grid.Row="2" Margin="0,0,17,0">
                                <StackPanel Orientation="Vertical">
                                    <Grid Margin="0,4,0,0">
                                        <TextBlock Text="{Binding PlayerControl.CurrentSeconds, Converter={StaticResource SecondsToDurationFormat}}" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding PlayerControl.RemainingSeconds, Converter={StaticResource SecondsToDurationFormat}}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <components:Timeline 
                                        CurrentSeconds="{Binding PlayerControl.CurrentSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TotalSeconds="{Binding MusicDisplay.TotalSeconds, Mode=OneWay}" Height="53" Margin="0,8,0,0">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="DragCompleted">
                                                <i:InvokeCommandAction Command="{Binding SeekCommand}" 
                                                                        CommandParameter="{Binding PlayerControl.CurrentSeconds}" />
                                            </i:EventTrigger>
                                            <i:EventTrigger EventName="DragStarted">
                                                <i:InvokeCommandAction Command="{Binding TimelineStartDraggingCommand}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </components:Timeline>

                                </StackPanel>

                            </Grid>

                        </Grid>
                        <!--Knob-->
                        <Grid Grid.Column="1">
                            <StackPanel Orientation="Vertical" Margin="22,0,8,0">
                                <Grid Margin="0,0,0,15">
                                    <Grid Width="140" Height="140" HorizontalAlignment="Left">
                                        <Border BorderBrush="White" BorderThickness="3" Width="70" Height="35" Margin="0,18,0,0" VerticalAlignment="Top" HorizontalAlignment="Right">
                                            <TextBlock Text="VOL" FontSize="20" VerticalAlignment="Center" Margin="2,2,2,0" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </Border>
                                        <components:AirKnob x:Name="VolumeKnob" MinValue="0" MaxValue="100" Value="{Binding PlayerControl.Volume, Mode=TwoWay}" SettingsKey="PlayerVolume" YDiff="5" RDiff="-2"/>
                                    </Grid>

                                    <Grid Width="140" Height="140" HorizontalAlignment="Right">
                                        <Border BorderBrush="White" BorderThickness="3" Width="70" Height="35" Margin="0,18,0,0" VerticalAlignment="Top" HorizontalAlignment="Right">
                                            <TextBlock Text="NAN" FontSize="20" VerticalAlignment="Center" Margin="2,2,2,0" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </Border>
                                        <components:AirKnob MinValue="0" MaxValue="100"  YDiff="5" RDiff="-2"/>
                                    </Grid>
                                </Grid>

                                <Grid Margin="0,0,0,15">
                                    <Grid Width="140" Height="140" HorizontalAlignment="Left">
                                        <Border BorderBrush="White" BorderThickness="3" Width="70" Height="35" Margin="0,18,0,0" VerticalAlignment="Top" HorizontalAlignment="Right">
                                            <TextBlock Text="NAN" FontSize="20" VerticalAlignment="Center" Margin="2,2,2,0" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </Border>
                                        <components:AirKnob MinValue="0" MaxValue="100"  YDiff="5" RDiff="-2"/>
                                    </Grid>

                                    <Grid Width="140" Height="140" HorizontalAlignment="Right">
                                        <Border BorderBrush="White" BorderThickness="3" Width="70" Height="35" Margin="0,18,0,0" VerticalAlignment="Top" HorizontalAlignment="Right">
                                            <TextBlock Text="NAN" FontSize="20" VerticalAlignment="Center" Margin="2,2,2,0" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </Border>
                                        <components:AirKnob MinValue="0" MaxValue="100"  YDiff="5" RDiff="-2"/>
                                    </Grid>
                                </Grid>

                                <Grid Margin="0,0,0,15">
                                    <Grid Width="140" Height="140" HorizontalAlignment="Left">
                                        <Border BorderBrush="White" BorderThickness="3" Width="70" Height="35" Margin="0,18,0,0" VerticalAlignment="Top" HorizontalAlignment="Right">
                                            <TextBlock Text="NAN" FontSize="20" VerticalAlignment="Center" Margin="2,2,2,0" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </Border>
                                        <components:AirKnob MinValue="0" MaxValue="100"  YDiff="5" RDiff="-2"/>
                                    </Grid>

                                    <Grid Width="140" Height="140" HorizontalAlignment="Right">
                                        <Border BorderBrush="White" BorderThickness="3" Width="70" Height="35" Margin="0,18,0,0" VerticalAlignment="Top" HorizontalAlignment="Right">
                                            <TextBlock Text="NAN" FontSize="20" VerticalAlignment="Center" Margin="2,2,2,0" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </Border>
                                        <components:AirKnob MinValue="0" MaxValue="100"  YDiff="5" RDiff="-2"/>
                                    </Grid>
                                </Grid>

                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!--Left Down Content-->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!--Music Information-->
                        <Grid Grid.Row="0" Margin="49,9,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <!--Music Switches-->
                                <Grid Width="70" Margin="0,6,0,0">
                                    <components:SwitchMusic Width="70"/>
                                </Grid>
                                <StackPanel Orientation="Vertical" Margin="16,3,0,0">
                                    <TextBlock Text="{Binding MusicDisplay.RateText}" FontSize="50" Margin="2,0,0,-4"/>
                                    <TextBlock Text="Rate(S/B k)" FontWeight="SemiBold" Margin="2,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,20,0">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding MusicDisplay.TotalSeconds, Converter={StaticResource SecondsToDurationFormat}}" FontSize="50" Margin="2,0,0,-8" HorizontalAlignment="Right"/>
                                    <TextBlock Text="DURATION" FontWeight="SemiBold" Margin="0,0,3,0" HorizontalAlignment="Right"/>
                                </StackPanel>
                                <!--The space 35 shall be fixed or smaller-->
                                <Grid Width="35"/>
                                <StackPanel Orientation="Vertical" Visibility="{Binding MusicDisplay.IsSingle, Converter={StaticResource BoolToVisConverter},ConverterParameter=Invert}">
                                    <TextBlock Text="{Binding MusicDisplay.Album}"  FontSize="50" Margin="2,0,0,-8" HorizontalAlignment="Right"/>
                                    <TextBlock Text="ALBUM" FontWeight="SemiBold" Margin="0,0,3,0" HorizontalAlignment="Right"/>
                                </StackPanel>
                                <Grid Width="35"/>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding MusicDisplay.Artist}" FontSize="50" Margin="2,0,0,-8" HorizontalAlignment="Right"/>
                                    <TextBlock Text="ARTIST" FontWeight="SemiBold" Margin="0,0,3,0" HorizontalAlignment="Right"/>
                                </StackPanel>

                            </StackPanel>
                        </Grid>
                        <!--Name & Channel-->
                        <Grid Grid.Row="1" Margin="49,19,24,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="LOAD" Margin="0,0,0,0" VerticalAlignment="Center"/>
                                <Grid Width="12"/>
                                <components:Button Width="540" Height="63" Margin="12,0,0,0" Text="{Binding MusicDisplay.Title}" Command="{Binding OpenFileCommand}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!--Channel-->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="DUAL" Margin="0,0,0,-6" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    <TextBlock Text="CHANNEL" Margin="0,0,0,0" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </StackPanel>
                                <Border BorderBrush="White" BorderThickness="3" Width="63" Height="63" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="L" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <Border BorderBrush="White" BorderThickness="3" Width="63" Height="63" Margin="18,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="R" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
                <!--RIGHT-->
                <Grid Grid.Column="1" Margin="0,32,48,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="163*"/>
                        <RowDefinition Height="74*"/>
                    </Grid.RowDefinitions>
                    <!--Right Up Content-->
                    <Grid Grid.Row="0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0">
                        <TextBlock Text="EMPTY" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock HorizontalAlignment="Center" FontSize="30" Text="转到设置显示封面、EQ曲线或更多"/>
                        </StackPanel>
                    </Grid>
                    <!--Right Down Content-->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="124*"/>
                            <RowDefinition Height="95*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,25">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="5*"/>
                                <RowDefinition Height="2*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <components:Button Margin="10,0,0,0" Text="循环" Command="{Binding SetLoopStatusCommand}" VerticalAlignment="Center"/>
                                    <components:Button Margin="10,0,0,0" Text="收藏" VerticalAlignment="Center"/>
                                    <components:Button Margin="10,0,0,0" Text="EQ" VerticalAlignment="Center"/>
                                    <components:Button Margin="10,0,0,0" Text="均衡" VerticalAlignment="Center"/>
                                    <components:Button Margin="10,0,0,0" Text="混音" VerticalAlignment="Center"/>
                                    <components:Button Margin="10,0,0,0" Text="设置" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="1" Background="White" Margin="10,0,0,0">
                                <StackPanel Margin="10,0,10,0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Foreground="Black" Text="EQ:NONE" FontSize="23" Margin="0,4,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="10,0,10,0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Foreground="Black" Text="无参数可用" FontSize="23" Margin="0,4,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="10,0,10,0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <components:ImageButton Source="{Binding ListController.ListIconSource}" Command="{Binding SetNoLoopCommand}"  Margin="1,1,1,1" Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="STOP" Margin="0,0,0,-6" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    <TextBlock Text="MUSIC" Margin="0,0,0,0" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </StackPanel>
                                <components:Button Width="63" Height="63" Margin="12,0,0,0" Text="■" Command="{Binding UnloadCurrentMusicCommand}" VerticalAlignment="Center"/>

                                <StackPanel Orientation="Vertical" Margin="30,0,0,0">
                                    <TextBlock Text="PLAY" Margin="0,0,0,-6" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    <TextBlock Text="LIST" Margin="0,0,0,0" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </StackPanel>
                                <components:Button Width="220" Command="{Binding SetPlaylistCommand}" Height="63" Margin="12,0,0,0" Text="NONE" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>


            </Grid>
            <!--Footer-->
            <Grid Grid.Row="1" Margin="48,0,48,20">
                <TextBlock Text="{Binding CurrentDeviceName}" FontSize="28" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CurrentTime, StringFormat=HH:mm:ss}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Text="Tune 1.0alpha" FontSize="28" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
