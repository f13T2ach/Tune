<UserControl x:Class="Tune.Appearance.EffectToolsUI.EffectChain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tune.Appearance.EffectToolsUI"
             xmlns:components="clr-namespace:Tune.Components"
             xmlns:lang="clr-namespace:Tune.Assets.Localization"
             xmlns:content="clr-namespace:Tune.Components.Content"
             xmlns:converters="clr-namespace:Tune.Helpers.ValueConverters"
             xmlns:effects="clr-namespace:Tune.Engine.Effects"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1600">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />

        <!-- One row of the generic parameter editor.
             The Show flags of the parameter decide which control is visible. -->
        <DataTemplate DataType="{x:Type effects:EffectParameterSlot}">
            <Grid Margin="0,3">
                <!-- Auto columns share their width across every row, so all names and
                     all values keep one font size and still fit. Only the bar takes
                     what is left. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MaxWidth="320" SharedSizeGroup="ParameterName" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MaxWidth="200" SharedSizeGroup="ParameterValue" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="White"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                           VerticalAlignment="Center" />

                <Slider Grid.Column="1" Margin="4,0" VerticalAlignment="Center"
                        Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                        SmallChange="{Binding SmallChange}" LargeChange="{Binding LargeChange}"
                        IsMoveToPointEnabled="True"
                        Value="{Binding Value, Mode=TwoWay}"
                        Visibility="{Binding ShowSlider, Converter={StaticResource BoolToVis}}" />

                <CheckBox Grid.Column="1" Margin="4,0" VerticalAlignment="Center"
                          IsChecked="{Binding BoolValue, Mode=TwoWay}"
                          Visibility="{Binding ShowToggle, Converter={StaticResource BoolToVis}}" />

                <ComboBox Grid.Column="1" Margin="4,0" VerticalAlignment="Center"
                          ItemsSource="{Binding Choices}"
                          SelectedIndex="{Binding ChoiceIndex, Mode=TwoWay}"
                          Visibility="{Binding ShowChoice, Converter={StaticResource BoolToVis}}" />

                <ProgressBar Grid.Column="1" Height="14" Margin="4,0" VerticalAlignment="Center"
                             Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                             Value="{Binding Value, Mode=OneWay}"
                             Visibility="{Binding ShowMeter, Converter={StaticResource BoolToVis}}" />

                <TextBlock Grid.Column="2" Text="{Binding DisplayValue}" Foreground="#AAAAAA"
                           TextAlignment="Right" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding DisplayValue}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- One node of the rack. The equalizer is never one of them: it is a
             fixed processor, not something the user stacks. -->
        <DataTemplate DataType="{x:Type effects:EffectSlot}">
            <content:EffectItem />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="5*" />
        </Grid.ColumnDefinitions>

        <!-- Chain view: the signal runs from Audio at the top down to Output -->
        <Grid Margin="10">
            <Border Background="White" Opacity="0.13" />
            <Grid Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Audio" FontWeight="SemiBold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Top" />
                    <Image Source="/Assets/Components/Arrow/SignalInDirection.png"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0"
                             ItemsSource="{Binding Effect.Slots}"
                             SelectedItem="{Binding Effect.SelectedSlot, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource CleanScrollBar}" />
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Opacity" Value="0.6" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.85" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- Add an effect from the catalog, as the NAudio demo does -->
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding Effect.AvailableEffects}"
                                  SelectedIndex="{Binding Effect.SelectedEffectIndex, Mode=TwoWay}" />

                        <components:Button Grid.Column="1" Text="+" Width="50" Margin="6,0,0,0"
                                Command="{Binding Effect.AddEffectCommand}"
                                ToolTip="{x:Static lang:LangStrings.AddEffectTooltip}" />
                    </Grid>
                </Grid>

                <StackPanel Grid.Row="2">
                    <Image Source="/Assets/Components/Arrow/SignalInDirection.png"
                           HorizontalAlignment="Center" VerticalAlignment="Top" />
                    <TextBlock Text="Output" FontWeight="SemiBold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Right side: the parameters of the node selected on the left -->
        <Grid Grid.Column="1">
            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- A nested markup extension is not allowed inside {Binding},
                             so the placeholder goes in through property elements. -->
                        <TextBlock FontSize="52" FontWeight="Bold" Foreground="White">
                            <TextBlock.Text>
                                <Binding Path="Effect.SelectedSlot.Name">
                                    <Binding.FallbackValue>
                                        <x:Static Member="lang:LangStrings.NoEffectSelected" />
                                    </Binding.FallbackValue>
                                    <Binding.TargetNullValue>
                                        <x:Static Member="lang:LangStrings.NoEffectSelected" />
                                    </Binding.TargetNullValue>
                                </Binding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static lang:LangStrings.Bypass}" Opacity="0.8" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <components:CheckBox IsChecked="{Binding Effect.SelectedSlot.Bypass, Mode=TwoWay}"
                                  VerticalAlignment="Center" Width="40" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Border Background="White" Opacity="0.13" />
                    <Grid>
                        <TextBlock Text="{x:Static lang:LangStrings.ParameterPanel}" Foreground="White"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" />
                        

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16,52,16,16">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource CleanScrollBar}" />
                            </ScrollViewer.Resources>
                            <ItemsControl Margin="10" Grid.IsSharedSizeScope="True"
                                          ItemsSource="{Binding Effect.SelectedSlot.Parameters}" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
