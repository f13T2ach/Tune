<UserControl x:Class="Tune.Appearance.SoundEffectTools.EffectPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tune.Appearance.SoundEffectTools"
             xmlns:tab="clr-namespace:Tune.Components.TabFrame"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600">
    
    <Grid>
        <tab:TabFrame SelectedIndex="0">

            <tab:TabFrame.TabTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Header}" FontSize="30" Margin="0,5,0,0" />
                </DataTemplate>
            </tab:TabFrame.TabTemplate>

            <tab:TabFrameItem Header="效果链">
                <TextBlock Text="正在准备效果链" Margin="16"/>
            </tab:TabFrameItem>

            <tab:TabFrameItem Header="混响">
                <TextBlock Text="正在准备混响" Margin="16"/>
            </tab:TabFrameItem>

        </tab:TabFrame>
    </Grid>
</UserControl>
