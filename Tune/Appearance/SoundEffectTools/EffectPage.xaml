<UserControl x:Class="Tune.Appearance.SoundEffectTools.EffectPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tune.Appearance.SoundEffectTools"
             xmlns:tab="clr-namespace:Tune.Components.TabFrame"
             xmlns:ui="clr-namespace:Tune.Appearance.EffectToolsUI"
             xmlns:lang="clr-namespace:Tune.Assets.Localization"
             xmlns:state="clr-namespace:Tune.Helpers.UiState"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600">
    
    <Grid>
        <tab:TabFrame SelectedIndex="0" state:TabFramePersistence.PersistKey="Effect">

            <tab:TabFrame.TabTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Header}" FontSize="30" Margin="0,5,0,0" />
                </DataTemplate>
            </tab:TabFrame.TabTemplate>

            <!-- The chain page stacks rack effects, which the equalizer is not:
                 it is a fixed processor, so its parameters have their own page. -->
            <tab:TabFrameItem Header="{x:Static lang:LangStrings.EffectChain}">
                <ui:EffectChain/>
            </tab:TabFrameItem>

            <tab:TabFrameItem Header="{x:Static lang:LangStrings.Gain}">
                <ui:ParameterPanel/>
            </tab:TabFrameItem>

            <tab:TabFrameItem Header="{x:Static lang:LangStrings.Reverb}">
                <Grid>
                    
                </Grid>
            </tab:TabFrameItem>
            

        </tab:TabFrame>
    </Grid>
</UserControl>
