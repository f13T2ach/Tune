<UserControl x:Class="Tune.Appearance.SoundEffectTools.SoundEffectMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tune.Appearance.SoundEffectTools"
             xmlns:lang="clr-namespace:Tune.Assets.Localization"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600">
    <Grid>
        <StackPanel Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0">
            <TextBlock Text="SOUND EFFCTS TOOLS" HorizontalAlignment="Center" FontWeight="SemiBold"/>
            <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="30" Text="{x:Static lang:LangStrings.SoundEffectPageHint}"/>
        </StackPanel>
        <Image Source="/Assets/TuneWallpaper.png"/>
    </Grid>
</UserControl>
