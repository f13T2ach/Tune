<UserControl x:Class="Tune.Appearance.SoundEffectTools.EqualizerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tune.Appearance.SoundEffectTools"
             xmlns:tab="clr-namespace:Tune.Components.TabFrame"
             xmlns:lang="clr-namespace:Tune.Assets.Localization"
             xmlns:ui="clr-namespace:Tune.Appearance.EffectToolsUI"
             xmlns:state="clr-namespace:Tune.Helpers.UiState"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600">
    <Grid>
        <tab:TabFrame SelectedIndex="0" state:TabFramePersistence.PersistKey="Equalizer">

            <tab:TabFrame.TabTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Header}" FontSize="30" Margin="0,5,0,0" />
                </DataTemplate>
            </tab:TabFrame.TabTemplate>

            <!-- The ten band equalizer lives on its own, the way the chain and the
                 parameter panel do on the effects page. -->
            <tab:TabFrameItem Header="{x:Static lang:LangStrings.TenBandEqualizer}">
                <ui:TenBandEqualizerPanel/>
            </tab:TabFrameItem>

            <tab:TabFrameItem Header="{x:Static lang:LangStrings.GraphicEqualizer}">

            </tab:TabFrameItem>


        </tab:TabFrame>
    </Grid>
</UserControl>
