<UserControl x:Class="Tune.Appearance.ExtendView.PeakMeterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:extend="clr-namespace:Tune.Appearance.ExtendView"
             xmlns:slider="clr-namespace:Tune.Components.Slider"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <extend:PeakMeterPanel Grid.Row="0"
            LeftLevel="{Binding AudioLevel.LeftLevel}"
            RightLevel="{Binding AudioLevel.RightLevel}"
            LeftAverage="{Binding AudioLevel.LeftAverage}"
            RightAverage="{Binding AudioLevel.RightAverage}"
            LeftPeak="{Binding AudioLevel.LeftPeak}"
            RightPeak="{Binding AudioLevel.RightPeak}"
            LeftWindowPeak="{Binding AudioLevel.LeftWindowPeak}"
            RightWindowPeak="{Binding AudioLevel.RightWindowPeak}"
            IsClipping="{Binding AudioLevel.IsClipping}"/>

        <Grid Grid.Row="1" Margin="10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0"
                      Content="OUTLMT"
                      FontSize="16"
                      VerticalAlignment="Center"
                      IsChecked="{Binding AudioLevel.IsOutputLimited, Mode=TwoWay}"/>

            <TextBlock Grid.Column="1"
                       Width="72"
                       Margin="10,0"
                       FontSize="16"
                       VerticalAlignment="Center"
                       TextAlignment="Right"
                       Text="{Binding AudioLevel.OutputLimitDecibels, StringFormat={}{0:0.0}dB}"/>

            <slider:CustomSlider Grid.Column="2"
                                 Minimum="-60"
                                 Maximum="0"
                                 Value="{Binding AudioLevel.OutputLimitDecibels, Mode=TwoWay}"
                                 OnlyThumbEvent="False"/>
        </Grid>
    </Grid>
</UserControl>