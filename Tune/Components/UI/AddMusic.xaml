<newdialog:DialogContentBase x:Class="Tune.Components.UI.AddMusic"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tune.Components.UI"
             xmlns:newdialog="clr-namespace:Tune.Models.NewDialog"
             xmlns:components="clr-namespace:Tune.Components"
             xmlns:input="clr-namespace:Tune.Components.InputBox"
             xmlns:frame="clr-namespace:Tune.Components.Frame"
             xmlns:lang="clr-namespace:Tune.Assets.Localization"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="800"
             >
    <Grid Background="Black">
        <frame:WindowFrame Title="ADD MUSIC TO PLAYLIST">
            <!-- TAG: NAME_REPEAT_PROBLEM -->
        </frame:WindowFrame>
        <Grid Margin="20,42,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题行 -->
            <Grid Grid.Row="0" Margin="0,0,0,7">
                <StackPanel Orientation="Vertical">
                    <TextBlock
                               Text="ADD MUSIC TO PLAYLIST" 
                               FontSize="28"/>
                    <StackPanel Orientation="Horizontal">
                    <TextBlock
                                Text="{x:Static lang:LangStrings.CurrentSelectedMusic}" 
                                FontSize="28"/>
                        <TextBlock
                                Text="" 
                                FontSize="28"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 输入区域 -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <!--无法读取text属性-->
                <components:Button x:Name="SelectMusicButton" Click="OnSelectMusicButtonClick" Height="44" Text="--"  VerticalAlignment="Center"/>
            </Grid>

            <!-- 按钮区域 -->
            <Grid Grid.Row="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <components:Button Text="{x:Static lang:LangStrings.Cancel}" FontSize="30" x:Name="CancelButton" Width="135" Margin="10,0,0,0"/>
                    <components:Button Text="{x:Static lang:LangStrings.Confirm}" FontSize="30" x:Name="ConfirmButton" Width="135" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <components:Button FontSize="30" Text="{x:Static lang:LangStrings.SelectPlayingMusic}" Margin="0,0,10,0" Click="OnSelectNowPlayingClick"/>
                    <!--<components:Button FontSize="30" Text="导入其他" Margin="0,0,10,0"/>-->
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</newdialog:DialogContentBase>