<newdialog:DialogContentBase x:Class="Tune.Components.UI.AskUserDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:newdialog="clr-namespace:Tune.Models.NewDialog"
             xmlns:components="clr-namespace:Tune.Components"
             xmlns:frame="clr-namespace:Tune.Components.Frame"
             xmlns:lang="clr-namespace:Tune.Assets.Localization"
             Width="760" Height="240"
             mc:Ignorable="d"
             d:DesignHeight="220" d:DesignWidth="760">
    <Grid Background="Black">
        <frame:WindowFrame x:Name="PART_Title"/>

        <Grid Margin="20,46,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="PART_Message" Grid.Row="0"
                       TextWrapping="Wrap" FontSize="28" VerticalAlignment="Center"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <components:Button x:Name="PART_Cancel" Text="{x:Static lang:LangStrings.Cancel}"
                                   FontSize="30" Width="135" Margin="10,0,0,0" Click="OnCancelClick"/>
                <components:Button x:Name="PART_Confirm" Text="{x:Static lang:LangStrings.Confirm}"
                                   FontSize="30" Width="135" Margin="10,0,0,0" Click="OnConfirmClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</newdialog:DialogContentBase>
