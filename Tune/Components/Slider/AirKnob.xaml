<UserControl x:Class="Tune.Components.AirKnob"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tune.Components"
             mc:Ignorable="d" 
             d:DesignHeight="256" d:DesignWidth="256"
             MouseLeftButtonDown="OnMouseLeftButtonDown"
             MouseLeftButtonUp="OnMouseLeftButtonUp"
             MouseMove="OnMouseMove"
             Background="Transparent">

    <Grid Background="Transparent">
        <!-- 背景旋钮边框 -->
        <Image Source="pack://application:,,,/Tune;component/Assets/Components/KnobBorder.png" 
               Stretch="Uniform"/>

        <!-- 填充扇形（无边框） -->
        <Path x:Name="FanFillPath" 
              Fill="#80FFFFFF"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- 边框路径（两条半径 + 弧线） -->
        <Path x:Name="FanStrokePath" 
              Stroke="White" StrokeThickness="3"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              StrokeLineJoin="Round"
              Fill="Transparent"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- 数值显示 -->
        <TextBlock x:Name="ValueTextBlock" 
                   Text="00" FontSize="45" 
                   Foreground="Red" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   Margin="0,0,0,7"
                   Visibility="Collapsed"/>

        <!-- 拖动时显示在弧末端的白色圆点 -->
        <Canvas x:Name="OverlayCanvas" 
            ClipToBounds="False"
            HorizontalAlignment="Stretch" 
            VerticalAlignment="Stretch">
            <Ellipse x:Name="DragDot"
                 Width="12" Height="12"
                 Fill="White"
                 Visibility="Collapsed"/>
            
            
        </Canvas>

        
    </Grid>
</UserControl>