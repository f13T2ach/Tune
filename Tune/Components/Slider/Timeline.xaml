<UserControl x:Class="Tune.Components.Timeline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="78" d:DesignWidth="800"
             x:Name="RootControl">
    <!--Generated By AI. Edited-->
    <Grid>
        <!-- 背景轨道图片 -->
        <Image Source="pack://application:,,,/Tune;component/Assets/Components/Timeline.png" Stretch="Fill" />

        <!-- 红色竖直线标记（宽度3，高度78） -->
        <Rectangle x:Name="RedLine"
                   Margin="0,1,0,0"
                   Width="5"
                   Height="78"
                   Fill="Red"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   IsHitTestVisible="False" />
        <!-- 防止拦截鼠标事件 -->

        <!-- 透明捕获层：用于接收所有鼠标事件，实现拖动 -->
        <Border x:Name="PART_DragArea"
                Background="Transparent"
                Cursor="Hand"
                MouseLeftButtonDown="OnDragAreaMouseDown"
                MouseMove="OnDragAreaMouseMove"
                MouseLeftButtonUp="OnDragAreaMouseUp"
                MouseLeave="OnDragAreaMouseLeave"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
    </Grid>
</UserControl>