<UserControl x:Class="Tune.Components.Slider.CustomSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Tune.Components.Slider"
             mc:Ignorable="d"
             d:DesignHeight="48" d:DesignWidth="800"
             x:Name="RootControl"
             Height="48"
             Focusable="True">

    <Grid x:Name="PART_Root" Background="Transparent">

        <!-- The part that is not reached yet -->
        <Rectangle x:Name="PART_Rest"
                   Height="33.6"
                   Margin="0,7.5,0,0"
                   Fill="White"
                   Opacity="0.15"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Stretch"
                   IsHitTestVisible="False"/>

        <!-- The part that is reached -->
        <Rectangle x:Name="PART_Fill"
                   Height="33.6"
                   Margin="0,7.5,0,0"
                   Width="0"
                   Fill="White"
                   Opacity="0.6"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   IsHitTestVisible="False"/>

        <!-- The handle, kept centred on the tip of the filled part; it is taller than the track
             so it sticks out above and below -->
        <Thumb x:Name="SliderThumb"
               Width="24"
               VerticalAlignment="Stretch"
               HorizontalAlignment="Left"
               Cursor="Hand"
               DragStarted="OnThumbDragStarted"
               DragDelta="OnThumbDragDelta"
               DragCompleted="OnThumbDragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Image Source="pack://application:,,,/Tune;component/Assets/Components/Thumb/SliderThumb.png"
                           Stretch="Uniform"
                           MaxHeight="48"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</UserControl>
