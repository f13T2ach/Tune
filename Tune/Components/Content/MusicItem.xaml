<UserControl x:Class="Tune.Components.Content.MusicItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Tune.Components.Content"
             xmlns:components="clr-namespace:Tune.Components"
             mc:Ignorable="d"
             d:DesignHeight="130" d:DesignWidth="1512">

    <!-- 根 Grid 必须有 Background，否则空白区域不参与命中测试 -->
    <Grid x:Name="RootGrid"
          Background="Transparent"
          MouseEnter="RootGrid_MouseEnter"
          MouseLeave="RootGrid_MouseLeave"
          MouseLeftButtonDown="RootGrid_MouseLeftButtonDown"
          MouseLeftButtonUp="RootGrid_MouseLeftButtonUp"
          LostMouseCapture="RootGrid_LostMouseCapture">

        <StackPanel Orientation="Horizontal" Margin="20">
            <Image Source="/Assets/Icons/BlankAlbum.png" Width="85" Margin="0,0,20,0"/>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <TextBlock Text="Item Name" x:Name="MusicNameText" FontWeight="Bold"/>
                <TextBlock Text="Artist Name" x:Name="ArtistNameText"/>
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="ButtonPanel"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="20"
            Background="Transparent"
            MouseEnter="ButtonPanel_MouseEnter"
            MouseLeave="ButtonPanel_MouseLeave">
            <components:ImageButton Source="/Assets/Components/MusicItemButtons/PlayNext.png"
                            ClickEffect="True" Margin="10" Width="40"
                            Command="{Binding PlayNextCommand, RelativeSource={RelativeSource AncestorType=local:MusicItem}}"
                            CommandParameter="{Binding Music, RelativeSource={RelativeSource AncestorType=local:MusicItem}}"/>

            <components:ImageButton
                Source="/Assets/Components/MusicItemButtons/AddToPlaylist.png"
                ClickEffect="True" Margin="10" Width="40"
                Command="{Binding AddToPlaylistCommand, RelativeSource={RelativeSource AncestorType=local:MusicItem}}"
                CommandParameter="{Binding Music, RelativeSource={RelativeSource AncestorType=local:MusicItem}}"/>

            <components:ImageButton
                Source="/Assets/Components/MusicItemButtons/MoreInformation.png"
                ClickEffect="True" Margin="10" Width="40"
                Command="{Binding MoreCommand, RelativeSource={RelativeSource AncestorType=local:MusicItem}}"
                CommandParameter="{Binding Music, RelativeSource={RelativeSource AncestorType=local:MusicItem}}"/>

            <components:ImageButton
                Source="/Assets/Components/MusicItemButtons/Delete.png"
                ClickEffect="True" Margin="10" Width="40"
                Command="{Binding DeleteCommand, RelativeSource={RelativeSource AncestorType=local:MusicItem}}"
                CommandParameter="{Binding Music, RelativeSource={RelativeSource AncestorType=local:MusicItem}}"/>
        </StackPanel>
    </Grid>
</UserControl>