<UserControl x:Class="Tune.Components.Content.PanelSwitcher"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <!-- A turned off button keeps its shape but fades, so the pages stay where they are. -->
        <Style x:Key="TriangleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Opacity" Value="1"/>
            <!-- Fuck the default border -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <!-- Fuck the Windows -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Name and position, for example "DDJ-1000 WHEEL 1/2" -->
        <TextBlock x:Name="PART_Header"
                   Grid.Row="0"
                   FontSize="22"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <!-- The panel of the current page sits here -->
        <ContentPresenter x:Name="PART_Presenter"
                          Grid.Row="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"/>

        <!-- Pages are turned by the two triangles; the left one tells where you are, the right
             one tells how many there are. -->
        <Button x:Name="PART_Previous"
                Grid.Row="1"
                Style="{StaticResource TriangleButton}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Click="Previous_Click">
            <Grid Width="38" Height="38">
                <Path Data="M0,0 L76,0 L0,76 Z" Fill="White" Stretch="Fill"/>
                <TextBlock x:Name="PART_CurrentNumber"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="Black"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="5,2,0,0"/>
            </Grid>
        </Button>

        <Button x:Name="PART_Next"
                Grid.Row="1"
                Style="{StaticResource TriangleButton}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Click="Next_Click">
            <Grid Width="38" Height="38">
                <Path Data="M0,0 L76,0 L76,76 Z" Fill="White" Stretch="Fill"/>
                <TextBlock x:Name="PART_TotalNumber"
                           FontSize="22"
                           Foreground="Black"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Margin="0,2,5,0"/>
            </Grid>
        </Button>
    </Grid>
</UserControl>
