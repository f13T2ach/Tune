<UserControl x:Class="Tune.Components.Content.NewPlaylistItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tune.Components.Content"
             xmlns:components="clr-namespace:Tune.Components"
             mc:Ignorable="d" 
             d:DesignHeight="321" d:DesignWidth="221">
    <Grid>
        <Grid  VerticalAlignment="Top">
            <components:RotatingBox/>
            <components:ImageButton Source="/Assets/Components/PlaylistBegin.png" Width="45" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="15"/>
        </Grid>
        <Grid  VerticalAlignment="Bottom">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="新" FontWeight="SemiBold" FontSize="45"/>
                <TextBlock Text="按封面新建" FontSize="30"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
