<UserControl x:Class="Tune.Components.Content.PlaylistItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Tune.Components.Content"
             xmlns:components="clr-namespace:Tune.Components"
             mc:Ignorable="d"
             d:DesignHeight="321" d:DesignWidth="221"
             x:Name="Root">
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
        <Grid Width="221" Height="321">
            <!-- 上部封面 + 播放按钮 -->
            <Grid VerticalAlignment="Top">
                <!-- 普通封面：点击打开歌单 -->
                <Grid Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Cover_Click">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Playlist.isEmptyOrNotInited, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Image Source="/Assets/Icons/BlankAlbum.png" Width="221"/>
                </Grid>

                <!-- 空封面：显示旋转方块，点击即新建歌单 -->
                <components:RotatingBox Cursor="Hand" MouseLeftButtonUp="Cover_Click">
                    <components:RotatingBox.Style>
                        <Style TargetType="components:RotatingBox">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Playlist.isEmptyOrNotInited, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </components:RotatingBox.Style>
                </components:RotatingBox>

                <!-- 播放键：两种封面都在，且盖在封面之上。空封面上点它即把当前歌单置空 -->
                <components:ImageButton x:Name="PlayButton"
                                        Source="/Assets/Components/PlaylistBegin.png"
                                        Width="45"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="15"
                                        Cursor="Hand"
                                        Command="{Binding PlayCommand, ElementName=Root}"
                                        CommandParameter="{Binding Playlist, ElementName=Root}"/>
            </Grid>

            <!-- 下部文字信息 -->
            <Grid VerticalAlignment="Bottom">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Binding Playlist.Name, ElementName=Root, FallbackValue='--'}"
                               FontWeight="SemiBold" FontSize="45"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Playlist.Description, ElementName=Root, FallbackValue='Unknown'}"
                               FontSize="30"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>