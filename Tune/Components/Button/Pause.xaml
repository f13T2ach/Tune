<UserControl x:Class="Tune.Components.Pause"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tune.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Cursor="Hand">
        <Image Source="pack://application:,,,/Tune;component/Assets/Components/PauseButton.png" Width="52" Height="52" Margin="0,0,0,0"/>
        <Image Source="pack://application:,,,/Tune;component/Assets/Components/PlayButton.png" Width="52" Height="52" Margin="1,0,0,0" Visibility="Hidden"/>
    </Grid>
</UserControl>
