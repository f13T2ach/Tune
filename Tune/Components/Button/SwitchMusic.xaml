<UserControl x:Class="Tune.Components.SwitchMusic"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Tune.Components"
             x:Name="Root"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="400">

    <Viewbox Stretch="Uniform">
        <Grid Width="400" Height="400" Background="Black">

            <!-- 1. LAST 按钮：模板根元素就是 Path，命中区域 = 左上三角 -->
            <Button x:Name="PART_LastButton"
                    Command="{Binding LastCommand, ElementName=Root}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Path Data="M 0,0 L 400,0 L 0,400 Z"
                              Fill="White" />
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 2. NEXT 按钮：模板根元素就是 Path，命中区域 = 右下三角 -->
            <Button x:Name="PART_NextButton"
                    Command="{Binding NextCommand, ElementName=Root}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Path Data="M 400,400 L 400,0 L 0,400 Z"
                              Fill="Black"
                              Stroke="White"
                              StrokeThickness="20" />
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 3. 标签层：独立叠加在上层，不参与命中测试 -->
            <Grid IsHitTestVisible="False">
                <TextBlock Text="LAST"
                           Foreground="Black" FontSize="60" FontWeight="Bold"
                           FontFamily="Arial"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           Margin="20" />
                <TextBlock Text="NEXT"
                           Foreground="White" FontSize="64" FontWeight="Bold"
                           FontFamily="Arial"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Margin="20" />
            </Grid>

        </Grid>
    </Viewbox>
</UserControl>