<UserControl x:Class="Tune.Components.RotatingBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="200"
             Background="Transparent">

    <Viewbox Stretch="Uniform" Cursor="Hand">
        <Grid x:Name="LayoutRoot" Width="200" Height="200" Background="Transparent">

            <VisualStateManager.VisualStateGroups>

                <!-- Hover states: rotation + inner fade -->
                <VisualStateGroup x:Name="HoverStates">
                    <VisualState x:Name="NotHovered">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="GroupRotation"
                                             Storyboard.TargetProperty="Angle"
                                             To="0" Duration="0:0:0.35">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="InnerSquare"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.35"/>
                            <DoubleAnimation Storyboard.TargetName="MainDiagonal"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.35"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Hovered">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="GroupRotation"
                                             Storyboard.TargetProperty="Angle"
                                             To="45" Duration="0:0:0.35">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="InnerSquare"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.35"/>
                            <DoubleAnimation Storyboard.TargetName="MainDiagonal"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.35"/>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>

                <!-- Press states: overall opacity (multiplicative on children) -->
                <VisualStateGroup x:Name="PressStates">
                    <VisualState x:Name="NotPressed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="OpacityContainer"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.1"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="OpacityContainer"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0.75" Duration="0:0:0.1"/>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>

            </VisualStateManager.VisualStateGroups>

            <!-- Parent-level opacity: children inherit it multiplicatively -->
            <Grid x:Name="OpacityContainer">
                <Canvas Width="200" Height="200">

                    <!--
                        Outer frame:
                          stroke thickness = 3, centered on the path.
                          Placing the rect at (1.5,1.5) with size 197x197 puts its
                          outer edge at 0..200 and its inner edge at 3..197.
                    -->
                    <Rectangle Width="197" Height="197"
                               Canvas.Left="1.5" Canvas.Top="1.5"
                               Stroke="White" StrokeThickness="3"
                               StrokeLineJoin="Miter"/>

                    <!--
                        Main diagonal:
                          endpoints pulled in to the frame's inner edge (3 .. 197)
                          so the stroke no longer pokes past the frame corners.
                    -->
                    <Line x:Name="MainDiagonal"
                          X1="3"   Y1="197"
                          X2="197" Y2="3"
                          Stroke="White" StrokeThickness="3"
                          StrokeStartLineCap="Flat"
                          StrokeEndLineCap="Flat"/>

                    <!--
                        Center group: 92x92 box centered on (100,100) -> top-left (54,54).
                        RenderTransformOrigin 0.5,0.5 makes the rotation pivot on its center.
                    -->
                    <Canvas x:Name="CenterGroup"
                            Canvas.Left="54" Canvas.Top="54"
                            Width="92" Height="92"
                            RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="GroupRotation" Angle="0"/>
                        </Canvas.RenderTransform>

                        <!-- Inner square: rect at (1.5,1.5) size 89x89 -> inner edge 3..89 -->
                        <Rectangle x:Name="InnerSquare"
                                   Width="89" Height="89"
                                   Canvas.Left="1.5" Canvas.Top="1.5"
                                   Stroke="White" StrokeThickness="3"
                                   StrokeLineJoin="Miter"/>

                        <!-- Inner X: endpoints pulled in to the inner square's inner edge (3..89) -->
                        <Line X1="3"  Y1="3"  X2="89" Y2="89"
                              Stroke="White" StrokeThickness="3"
                              StrokeStartLineCap="Flat"
                              StrokeEndLineCap="Flat"/>
                        <Line X1="89" Y1="3"  X2="3"  Y2="89"
                              Stroke="White" StrokeThickness="3"
                              StrokeStartLineCap="Flat"
                              StrokeEndLineCap="Flat"/>
                    </Canvas>

                </Canvas>
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>