<UserControl x:Class="Tune.Components.Button"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="160"
             Cursor="Hand"
             x:Name="RootControl">

    <UserControl.Resources>
        <!-- 仅保留默认样式，不包含触发器 -->
        <Style TargetType="Border" x:Key="MainBorderStyle">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Padding" Value="0,0"/>
        </Style>
    </UserControl.Resources>

    <!-- 直接让 Border 响应所有鼠标事件 -->
    <Border x:Name="MainBorder" 
            Style="{StaticResource MainBorderStyle}"
            MouseEnter="MainBorder_MouseEnter"
            MouseLeave="MainBorder_MouseLeave"
            MouseLeftButtonDown="MainBorder_MouseLeftButtonDown"
            MouseLeftButtonUp="MainBorder_MouseLeftButtonUp">

        <TextBlock x:Name="ButtonText" 
                   Text="按钮"
                   Foreground="White"
                   Margin="4,4,4,0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"/>
    </Border>
</UserControl>