<UserControl x:Class="Tune.Components.VolumeBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tune.Components"
             mc:Ignorable="d" 
             d:DesignHeight="63" d:DesignWidth="526">

    <!-- 固定总宽度，并且垂直居中 -->
    <Grid Width="526" Height="63" VerticalAlignment="Center" Background="Black">

        <!-- 白色边框轨道 -->
        <Border BorderBrush="White" Height="45" BorderThickness="3">

            <!-- Canvas 允许精确布局，Margin="3" 刚好内缩避开外边框，ClipToBounds 防止进度条溢出 -->
            <Canvas ClipToBounds="True" Margin="3">

                <!-- 1. 进度填充块：只需在后台代码改变其 Width -->
                <Rectangle x:Name="Progress" 
                           Height="39" 
                           Width="0" 
                           Fill="White" 
                           Opacity="0.7" 
                           Canvas.Left="0" 
                           Canvas.Top="0" 
                           IsHitTestVisible="False" />

                <!-- 2. 竖直线标记：通过绑定自动贴合 Progress 的右边 -->
                <Rectangle x:Name="Line" 
                           Width="3.5" 
                           Height="39" 
                           Fill="White" 
                           Canvas.Top="0" 
                           Canvas.Left="{Binding ElementName=Progress, Path=Width}" 
                           IsHitTestVisible="False" />

            </Canvas>
        </Border>
    </Grid>
</UserControl>