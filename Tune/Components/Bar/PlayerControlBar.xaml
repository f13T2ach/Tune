<UserControl x:Class="Tune.Components.Bar.PlayerControlBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Tune.Components"
             xmlns:converters="clr-namespace:Tune.Helpers.ValueConverters"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="1600">

    <UserControl.Resources>
        <converters:SecondsToDurationConverter x:Key="SecondsToDurationFormat" />
    </UserControl.Resources>

    <Grid Background="#404040">
        <Grid Margin="49,0,24,0">
            <!-- Now Playing Info -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Grid Width="70" Margin="0,0,0,0">
                    <local:SwitchMusic Cursor="Hand"  NextCommand="{Binding PlayNextMusicCommand}" LastCommand="{Binding PlayPreviousMusicCommand}" Width="60"/>
                </Grid>
                <Grid Width="12"/>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Binding MusicDisplay.Title}" Margin="0,0,0,-6" FontSize="32" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding MusicDisplay.Artist}" Margin="0,0,0,0" FontSize="30" />
                </StackPanel>
            </StackPanel>

            <!-- Timeline -->
            <local:Timeline HorizontalAlignment="Center" Width="500"
                            IsEnded="True"
                            CurrentSeconds="{Binding PlayerController.CurrentSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TotalSeconds="{Binding MusicDisplay.TotalSeconds, Mode=OneWay}"
                            Height="21" Margin="-15,8,0,0">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="DragCompleted">
                        <i:InvokeCommandAction Command="{Binding SeekCommand}"
                                               CommandParameter="{Binding PlayerController.CurrentSeconds}" />
                    </i:EventTrigger>
                    <i:EventTrigger EventName="DragStarted">
                        <i:InvokeCommandAction Command="{Binding TimelineStartDraggingCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </local:Timeline>

            <!-- Channel -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Grid Width="12"/>
                <Grid Width="12"/>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Binding PlayerController.CurrentSeconds, Converter={StaticResource SecondsToDurationFormat}}"
                               Margin="0,0,0,-6" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding MusicLyric.Lyric}" Margin="0,0,0,0" FontSize="30" HorizontalAlignment="Right" />
                </StackPanel>
                <Grid HorizontalAlignment="Right" Width="90" Margin="0,0,0,5">
                    <local:Pause IsPlaying="{Binding PlayerController.IsPlaying, Mode=OneWay}"
                                 ToggleCommand="{Binding PlayerController.TogglePlayPauseCommand}"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>