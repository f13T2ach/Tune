<UserControl x:Class="Tune.Components.InputBox.SimpleInputBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="Root">
    <!-- 添加名称用于绑定 -->
    <Border BorderBrush="White" 
            BorderThickness="2" 
            Background="Transparent"
            CornerRadius="0">
        <Grid>
            <TextBox x:Name="PART_TextBox"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White"
                     CaretBrush="White"
                VerticalContentAlignment="Center"
                     Text="{Binding ElementName=Root, Path=Text, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                     SelectionBrush="#FF3399FF"
                     SelectionOpacity="0.7"
                     GotFocus="OnGotFocus"
                     LostFocus="OnLostFocus"
                     TextChanged="OnTextChanged"/>
                <TextBlock x:Name="PART_Hint"
                       Text="{Binding ElementName=Root, Path=Hint}"
                       Foreground="#888888"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Visibility="Collapsed"/>
        </Grid>
    </Border>
</UserControl>